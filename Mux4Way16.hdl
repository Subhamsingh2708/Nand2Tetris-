// File name: projects/1/Mux4Way16.hdl
/**
 * 4-way 16-bit multiplexor:
 * out = a if sel = 00
 *       b if sel = 01
 *       c if sel = 10
 *       d if sel = 11
 */
CHIP Mux4Way16 {
    IN a[16], b[16], c[16], d[16], sel[2];
    OUT out[16];
    
    PARTS:
    
    Not(in=sel[0] , out=nsel0 );
    Not(in=sel[1] , out=nsel1 );
    
    And(a=nsel1 , b=nsel0 , out=ea );
    And(a=nsel1 , b=sel[0] , out=eb );
    And(a=sel[1] , b=nsel0 , out=ec );
    And(a=sel[1] , b=sel[0] , out=ed );

    And(a=a[0] , b=ea , out=pa0 );
    And(a=b[0] , b=eb , out=pb0 );
    And(a=c[0] , b=ec , out=pc0 );
    And(a=d[0] , b=ed , out=pd0 );
    Or(a=pa0 , b=pb0 , out=x0 );
    Or(a=x0 , b=pc0 , out=y0 );
    Or(a=y0 , b=pd0 , out=out[0] );
}