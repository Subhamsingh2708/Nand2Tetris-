CHIP ALU {
    IN  
        x[16], y[16],  // 16-bit inputs        
        zx, // zero the x input?
        nx, // negate the x input?
        zy, // zero the y input?
        ny, // negate the y input?
        f,  // compute (out = x + y) or (out = x & y)?
        no; // negate the out output?
    OUT 
        out[16], // 16-bit output
        zr,      // if (out == 0) equals 1, else 0
        ng;      // if (out < 0)  equals 1, else 0

    PARTS:

    // 1. Zero x if zx = 1
    Mux16(a=x, b=false, sel=zx, out=x1);

    // 2. Negate x if nx = 1
    Not16(in=x1, out=notx);
    Mux16(a=x1, b=notx, sel=nx, out=x2);


    // 3. Zero y if zy = 1
    Mux16(a=y, b=false, sel=zy, out=y1);

    // 4. Negate y if ny = 1
    Not16(in=y1, out=noty);
    Mux16(a=y1, b=noty, sel=ny, out=y2);


    // 5. Compute x+y or x&y
    And16(a=x2, b=y2, out=andout);
    Add16(a=x2, b=y2, out=addout);
    Mux16(a=andout, b=addout, sel=f, out=result);


    // 6. Negate output if no = 1
    Not16(in=result, out=notresult);

    Mux16(a=result, b=notresult, sel=no,
      out=out,
      out[0..7]=low,
      out[8..15]=high,
      out[15]=sign);


    // 7. zr = 1 if out == 0
    Or8Way(in=low, out=or1);
    Or8Way(in=high, out=or2);
    Or(a=or1, b=or2, out=anybit);
    Not(in=anybit, out=zr);


    // 8. ng = 1 if out < 0
    And(a=sign, b=true, out=ng);

    }